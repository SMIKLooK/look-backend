# Ключи провайдеров удобно вписать прямо в код: internal/keys/keys.go —
# тогда задавать переменные перед запуском не нужно.
# Переменные окружения имеют приоритет над значениями из keys.go.

# Адрес HTTP-сервера
LOOK_ADDR=:8080

# Ключевые слова старого формата: если текст начинается с одного из них,
# оно игнорируется (модель теперь указывается первым словом, без ключевого слова)
# LOOK_KEYWORDS=look,лук

# Псевдонимы моделей: "псевдоним=модель" через запятую.
# Встроенные (internal/config/config.go): гемини/gemini/gemeni → gemini-3.6-flash,
# гпт/gpt → openai/gpt-5.6-terra, клод/claude → anthropic/claude-sonnet-5,
# дипсик/deepseek → deepseek/deepseek-v4-flash.
# LOOK_MODEL_ALIASES=гпт=openai/gpt-5.6-terra

# Таймаут одного обращения к провайдеру
# LOOK_PROVIDER_TIMEOUT=60s

# Лимит размера тела запроса, байт (по умолчанию 1 МиБ)
# LOOK_MAX_BODY_BYTES=1048576

# Формат логов: text | json
# LOOK_LOG_FORMAT=text

# --- Google Gemini (ключ из aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash
# 0 — не отправлять maxOutputTokens в API
# GEMINI_MAX_TOKENS=0
# GEMINI_TIMEOUT=30s

# --- OpenAI / любой совместимый API (OpenRouter, vLLM, Ollama, ...) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o,gpt-4o-mini
# OPENAI_MAX_TOKENS=0
# OPENAI_TIMEOUT=30s

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODELS=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT=30s

# --- OpenRouter (агрегатор: модели всех вендоров одним ключом) ---
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=google/gemini-3.8-flash,openai/gpt-5.6-terra,anthropic/claude-sonnet-5
# OPENROUTER_MAX_TOKENS=0
# OPENROUTER_TIMEOUT=30s
