{
  "info": {
    "name": "look-backend",
    "description": "Коллекция для тестирования look-backend: первое слово текста — модель нейросети, остальное — запрос.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": ["{{baseUrl}}"],
          "path": ["healthz"]
        },
        "description": "Проверка живости сервера."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Доступные модели",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/models",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "models"]
        },
        "description": "Ключевые слова, псевдонимы моделей и провайдеры с их моделями."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"есть ключевые слова\", () => pm.expect(body.keywords).to.include(\"look\"));",
              "pm.test(\"gemeni — псевдоним gemini\", () => pm.expect(body.aliases.gemeni).to.eql(\"gemini-2.5-flash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Process — успех (echo, без ключей)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"echo Привет! Кто ты?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "process"]
        },
        "description": "Провайдер echo всегда доступен и возвращает запрос как есть — работает без API-ключей. Проверка API без реальных нейросетей."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status = ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
              "pm.test(\"провайдер echo\", () => pm.expect(body.provider).to.eql(\"echo\"));",
              "pm.test(\"в ответе есть текст запроса\", () => pm.expect(body.answer).to.include(\"Привет\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Process — реальный ответ Gemini",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"gemeni какая погода сегодня?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "process"]
        },
        "description": "Требуется ключ в internal/keys/keys.go (Gemini = \"...\"). gemeni — псевдоним модели gemini-3.6-flash."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status = ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
              "pm.test(\"провайдер gemini\", () => pm.expect(body.provider).to.eql(\"gemini\"));",
              "pm.test(\"модель gemini-3.6-flash\", () => pm.expect(body.model).to.eql(\"gemini-3.6-flash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Process — много моделей через OpenRouter",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"openai/gpt-5.6-terra Скажи коротко, кто ты!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "process"]
        },
        "description": "Требуется ключ OpenRouter в internal/keys/keys.go. Модель адресуется слагом vendor/model — подставьте любую из openrouter.ai/models."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status = ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
              "pm.test(\"провайдер openrouter\", () => pm.expect(body.provider).to.eql(\"openrouter\"));",
              "pm.test(\"модель — полный слаг\", () => pm.expect(body.model).to.include(\"/\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Process — короткое имя (гпт)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"гпт Скажи коротко, кто ты!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "process"]
        },
        "description": "Короткое имя гпт/gpt разворачивается в openai/gpt-5.6-terra и уходит в OpenRouter (нужен ключ OpenRouter в keys.go). Аналогично работают клод/claude, дипсик/deepseek."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status = ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
              "pm.test(\"модель — openai/gpt-5.6-terra\", () => pm.expect(body.model).to.eql(\"openai/gpt-5.6-terra\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat — диалог (шаг 1, новая сессия)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"echo Меня зовут Аня\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "chat"]
        },
        "description": "Диалоговый запрос: без session_id сервер создаст сессию и вернёт её ID. Скопируйте session_id из ответа в следующий запрос — модель будет видеть предыдущие реплики."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"session_id создан\", () => pm.expect(body.session_id).to.be.a(\"string\").and.not.empty);",
              "pm.collectionVariables.set(\"sessionId\", body.session_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat — диалог (шаг 2, та же сессия)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"text\": \"echo Как меня зовут?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "chat"]
        },
        "description": "Тот же session_id — модель видит историю. В поле messages видно, сколько сообщений ушло модели."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"история ушла модели (3 сообщения)\", () => pm.expect(body.messages).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat — история сессии",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/chat/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "chat", "{{sessionId}}"]
        },
        "description": "Сохранённые сообщения сессии (user/assistant по очереди)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"в истории 4 сообщения\", () => pm.expect(body.messages).to.have.lengthOf(4));"
            ]
          }
        }
      ]
    },
    {
      "name": "Chat — сбросить историю",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/v1/chat/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "chat", "{{sessionId}}"]
        },
        "description": "Полностью очищает историю сессии."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Process — ошибка: нет модели",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"look\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "process"]
        },
        "description": "Текст только из ключевого слова старого формата, модели в нём нет — ожидаем 400 MODEL_NOT_SPECIFIED."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"код MODEL_NOT_SPECIFIED\", () => pm.expect(pm.response.json().error.code).to.eql(\"MODEL_NOT_SPECIFIED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Process — ошибка: неизвестная модель",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"mystery-model привет\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "process"]
        },
        "description": "Модель не обслуживает ни один провайдер — ожидаем 400 UNKNOWN_MODEL."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"код UNKNOWN_MODEL\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNKNOWN_MODEL\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Process — ошибка: пустой текст",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "process"]
        },
        "description": "Пустое поле text — ожидаем 400 EMPTY_TEXT."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"код EMPTY_TEXT\", () => pm.expect(pm.response.json().error.code).to.eql(\"EMPTY_TEXT\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Process — ошибка: битый JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{это не json",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "process"]
        },
        "description": "Некорректный JSON — ожидаем 400 INVALID_JSON."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"код INVALID_JSON\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_JSON\"));"
            ]
          }
        }
      ]
    }
  ]
}
